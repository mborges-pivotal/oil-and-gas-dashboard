# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real keys. server.js loads it automatically (node server.js / ./run.sh);
# nothing else to install or configure. On Railway, use the service's
# Variables tab instead — .env files aren't deployed.

# Required for the Gas Prices tab. Free key: https://www.eia.gov/opendata/
EIA_API_KEY=

# Required for the Economic Indicators tab. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional. SEC EDGAR requires a real identifying User-Agent on automated
# requests or it starts 403'ing — set this to "Your App contact@example.com".
SEC_CONTACT=

# Optional. Port the server listens on (defaults to 3000).
# PORT=3000
